# Copiá este archivo a `.env.local` y completá con los valores de tu proyecto Supabase.
# En Vercel: Project Settings → Environment Variables (mismos nombres).

# --- Supabase (obligatorias) ---
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo servidor. Nunca usar prefijo NEXT_PUBLIC_ ni exponer al cliente.
# Requerida para: panel de usuarios, subida de contenido social.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Sitio (opcional en local) ---
# URL canónica sin barra final. Usada en sitemap.xml y metadatos.
# En Vercel suele ser https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
